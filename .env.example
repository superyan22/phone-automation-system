# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=phone_automation

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=your_redis_password_here

# ============================================
# Application Configuration
# ============================================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false

# ============================================
# ADB Configuration
# ============================================
ADB_PATH=adb
ADB_TIMEOUT=30

# ============================================
# Scrcpy Configuration
# ============================================
SCRCPY_PATH=scrcpy
SCRCPY_ENABLED=false

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:***@redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:***@redis:6379/2

# ============================================
# pgAdmin Configuration (optional)
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# ============================================
# Production Nginx Configuration
# ============================================
DOMAIN=your-domain.com
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
